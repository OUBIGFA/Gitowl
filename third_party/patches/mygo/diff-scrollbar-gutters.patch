diff --git a/ui/editor/gitowl_scrollbar_test.go b/ui/editor/gitowl_scrollbar_test.go
new file mode 100644
--- /dev/null
+++ b/ui/editor/gitowl_scrollbar_test.go
@@ -0,0 +1,45 @@
+package editor
+
+import (
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/egoist/mygo/ui"
+)
+
+func TestGitowlDiffPersistentScrollbarsReserveContentSpace(t *testing.T) {
+	for _, layout := range []DiffLayout{DiffSplit, DiffUnified} {
+		before := strings.Repeat(strings.Repeat("wide text ", 40)+"\n", 35)
+		diff := &DiffState{
+			Old: NewBuffer(before), New: NewBuffer(before + "last visible line\n"),
+			Layout: layout, KeepScrollbars: true, ExpandUnchanged: true,
+		}
+		tester := ui.NewTester(func(c *ui.Context) { DiffView(c, diff).Fill() }, 700, 320)
+		tester.Advance(time.Second)
+		editor := &diff.eds[1]
+		if _, horizontal := editor.scrollbars(); !horizontal {
+			t.Fatal("the long-line fixture did not need a horizontal scrollbar")
+		}
+		if editor.viewH > editor.hbarY {
+			t.Fatalf("layout %v: content height %v runs under scrollbar at %v", layout, editor.viewH, editor.hbarY)
+		}
+		diff.SetScrollY(1e9)
+		tester.Frame()
+		if bottom := editor.view.heights.total() - diff.ScrollY(); bottom > float64(editor.hbarY)+0.1 {
+			t.Fatalf("layout %v: last line ends at %v below scrollbar %v", layout, bottom, editor.hbarY)
+		}
+		diff.Wrap = true
+		tester.Frame()
+		tester.Advance(time.Second)
+		if diff.ViewportHeight() != 320 {
+			t.Fatal("wrapped lines lost space to an absent horizontal scrollbar")
+		}
+		diff.Wrap, diff.NoScrollbars = false, true
+		tester.Frame()
+		tester.Advance(time.Second)
+		if diff.ViewportHeight() != 320 {
+			t.Fatal("hidden scrollbars still reserve content space")
+		}
+	}
+}
