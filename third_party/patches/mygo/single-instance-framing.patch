+//go:build !js
+
+package mygo
+
+import (
+	"encoding/json/v2"
+	"net"
+	"slices"
+	"testing"
+	"time"
+)
+
+// A complete launch object is the message boundary. Windows AF_UNIX can delay
+// write-side EOF; a still-open sender must not make a valid launch disappear.
+func TestGitowlSecondInstanceDoesNotWaitForSenderEOF(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	go acceptSecondInstances(listener)
+	got := make(chan []string, 1)
+	off := App.OnSecondInstance(func(args []string, wd string) { got <- args })
+	defer off()
+	connection, err := net.Dial("tcp", listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer connection.Close()
+	message, err := json.Marshal(secondInstanceMessage{Args: []string{"--cli-open", "project with spaces"}, WorkingDir: "fixture"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := connection.Write(message[:len(message)/2]); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-got:
+		t.Fatal("partial message was dispatched")
+	case <-time.After(25 * time.Millisecond):
+	}
+	if _, err := connection.Write(message[len(message)/2:]); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case args := <-got:
+		if !slices.Equal(args, []string{"--cli-open", "project with spaces"}) {
+			t.Fatalf("arguments changed: %q", args)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("complete launch waited for sender EOF")
+	}
+}
