+// SplitFixed lays out the same panes as Split, with a noninteractive divider.
+// Switching between them keeps the panes' native focus, undo and scroll state.
+// The app owns *size; neither pointer nor keyboard input changes it.
+func SplitFixed(c *Context, size *float32, first func(), second func()) Element {
+	_ctx := c.build()
+	if _ctx == nil {
+		return Element{}
+	}
+	_ctx.rt.beginBuild()
+	_e := coreSplitFixed(_ctx, size, first, second)
+	_ctx.rt.endBuild()
+	return wrapElement(_e)
 }
 
