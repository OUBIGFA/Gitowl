diff --git a/ui/editor/diff_context_menu_test.go b/ui/editor/diff_context_menu_test.go
new file mode 100644
index 0000000000..c41d360d38
--- /dev/null
+++ b/ui/editor/diff_context_menu_test.go
@@ -0,0 +1,60 @@
+package editor
+
+import (
+	"fmt"
+	"slices"
+	"testing"
+
+	"github.com/egoist/mygo/ui"
+)
+
+func TestDiffContextMenuExtensionKeepsEditingItems(t *testing.T) {
+	for _, presentation := range []ui.MenuPresentation{ui.SystemMenus, ui.PopoverMenus} {
+		for _, layout := range []DiffLayout{DiffSplit, DiffUnified} {
+			xs := []float32{180}
+			if layout == DiffSplit {
+				xs = append(xs, 630)
+			}
+			for _, x := range xs {
+				t.Run(fmt.Sprintf("presentation=%d/layout=%d/x=%v", presentation, layout, x), func(t *testing.T) {
+					d := &DiffState{Old: NewBuffer("old line\n"), New: NewBuffer("new line\n"), Layout: layout}
+					chosen := 0
+					d.ContextMenu = func(m *ui.Menu) {
+						if m.Item("Review selected change").ID("review").Chosen() {
+							chosen++
+						}
+					}
+					tt := ui.NewTester(func(c *ui.Context) { c.SetMenuPresentation(presentation); DiffView(c, d).Fill() }, 900, 400)
+					tt.Frame()
+					if chosen != 0 {
+						t.Fatal("building the diff invoked its context action")
+					}
+					tt.RightClickAt(x, 15)
+					labels := tt.Menu()
+					if !slices.Contains(labels, "Copy") || !slices.Contains(labels, "Select All") || !slices.Contains(labels, "Review selected change") {
+						t.Fatalf("context menu lost original editing or extension items: %v", labels)
+					}
+					if err := tt.ChooseMenuItem("Review selected change"); err != nil {
+						t.Fatal(err)
+					}
+					if chosen != 1 || d.Old.String() != "old line\n" || d.New.String() != "new line\n" {
+						t.Fatal("context action was lost, replayed, or edited the diff")
+					}
+					// Nil remains exactly the standard editor menu; no stale callback.
+					d.ContextMenu = nil
+					tt.Frame()
+					tt.RightClickAt(x, 15)
+					if slices.Contains(tt.Menu(), "Review selected change") {
+						t.Fatal("removed context extension was retained")
+					}
+					tt.CloseMenu()
+					tt.ClickAt(x, 15)
+					tt.Key(ui.Shift, ui.KeyF10)
+					if !slices.Contains(tt.Menu(), "Copy") {
+						t.Fatalf("keyboard context menu lost its native editing commands: %v", tt.Menu())
+					}
+				})
+			}
+		}
+	}
+}
