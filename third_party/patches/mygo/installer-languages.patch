+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestGitowlInstallerProcessMessages(t *testing.T) {
+	script := nsisCloseApp(&Config{Name: "Gitowl"}, appLanguage{Tag: "en"}, appLanguage{Tag: "zh-Hans"}, appLanguage{Tag: "zh-CN"}, appLanguage{Tag: "zh-Hant"})
+	for _, text := range []string{
+		`LangString MYGO_CLOSE_APP ${LANG_ENGLISH} "Gitowl is running. Close it to continue?"`,
+		`LangString MYGO_CLOSE_APP ${LANG_SIMPCHINESE} "Gitowl 正在运行。是否关闭并继续？"`,
+		`LangString MYGO_APP_STILL_RUNNING ${LANG_SIMPCHINESE} "Gitowl 仍在运行。请退出后重试。"`,
+		`LangString MYGO_CLOSE_APP ${LANG_TRADCHINESE} "Gitowl 正在執行。是否關閉並繼續？"`,
+		`LangString MYGO_APP_STILL_RUNNING ${LANG_TRADCHINESE} "Gitowl 仍在執行。請結束後重試。"`,
+	} {
+		if strings.Count(script, text) != 1 {
+			t.Errorf("missing or duplicate language text %q", text)
+		}
+	}
+	if strings.Count(script, `MessageBox MB_OKCANCEL|MB_ICONEXCLAMATION "$(MYGO_CLOSE_APP)"`) != 2 {
+		t.Fatal("install/uninstall must use the chosen language")
+	}
+	if strings.Count(script, `MessageBox MB_OK|MB_ICONSTOP "$(MYGO_APP_STILL_RUNNING)"`) != 2 {
+		t.Fatal("stuck-process messages must use the chosen language")
+	}
+}
