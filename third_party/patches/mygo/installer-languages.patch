+; A just-exited helper or Explorer can briefly retain a file. Retry the
+; actual deletion for five seconds, then report failure without discarding
+; the installation registration needed by a repair installation.
+Function un.RemoveAppFiles
+  Push $0
+  StrCpy $0 50
+  SetOutPath "$TEMP"
+  retry_remove:
+    IfFileExists "$INSTDIR\*.*" 0 removed
+    ClearErrors
+    RMDir /r "$INSTDIR"
+    IfErrors 0 removed
+    IntOp $0 $0 - 1
+    IntCmp $0 0 remove_failed
+    Sleep 100
+    Goto retry_remove
+  remove_failed:
+    Pop $0
+    MessageBox MB_OK|MB_ICONSTOP "$(MYGO_REMOVE_FAILED)" /SD IDOK
+    SetErrorLevel 1
+    Quit
+  removed:
+    Pop $0
+FunctionEnd
+
 Section "Uninstall"
   Push "$INSTDIR"
   Call un.CloseApp
+` + uninstall + `  Call un.RemoveAppFiles
   Push "$SMPROGRAMS\` + shortcut + `"
   Call un.DeleteShortcut
   Push "$DESKTOP\` + shortcut + `"
   Call un.DeleteShortcut
   DeleteRegKey HKCU ` + nsisString(uninstallKey) + `
-` + unregister + uninstall + `  ; Last, so that the app's folder is gone once the uninstall is done:
-  ; the uninstaller runs from a copy of itself that nothing waits for.
-  RMDir /r "$INSTDIR"
-SectionEnd
+` + unregister + `SectionEnd
 `, nil
 }
 
