+++ b/cmd/mygo/gitowl_uninstall_windows_test.go
@@ -0,0 +1,136 @@
+package main
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	windows "syscall"
+)
+
+// Exercise the generated uninstaller against actual Windows sharing locks.
+// A successful process exit must mean its files and registration are gone.
+func TestGitowlInstallerRemoval(t *testing.T) {
+	compiler := makensis()
+	if compiler == "" {
+		t.Fatal("the installer regression requires the registered NSIS compiler")
+	}
+	base := t.TempDir()
+	name := fmt.Sprintf("Gitowl Removal Test %d", os.Getpid())
+	identifier := fmt.Sprintf("io.github.oubigfa.gitowl.removal-test-%d", os.Getpid())
+	key := `HKCU\Software\Microsoft\Windows\CurrentVersion\Uninstall\` + identifier
+	c := &Config{Name: name, Identifier: identifier, Version: "0.0.1"}
+	payload := filepath.Join(base, "payload.dat")
+	if err := os.WriteFile(payload, []byte("owned deletion fixture"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	setup := filepath.Join(base, "setup.exe")
+	script, err := installerScript(c, setup, "unused.exe", "  File "+nsisString(payload)+"\n", "", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	nsi := filepath.Join(base, "fixture.nsi")
+	if err := writeNSIS(nsi, script); err != nil {
+		t.Fatal(err)
+	}
+	if out, err := exec.Command(compiler, "-V2", nsi).CombinedOutput(); err != nil {
+		t.Fatalf("compile: %v\n%s", err, out)
+	}
+	registered := func() bool { return exec.Command("reg.exe", "query", key).Run() == nil }
+	if registered() {
+		t.Fatal("test registration already exists")
+	}
+	for _, mode := range []string{"unlocked", "temporary-lock", "persistent-lock"} {
+		t.Run(mode, func(t *testing.T) {
+			install := filepath.Join(base, mode)
+			// NSIS parses /D and _? as an unquoted tail, even with spaces.
+			installCmd := exec.Command(setup)
+			installCmd.SysProcAttr = &windows.SysProcAttr{CmdLine: windows.EscapeArg(setup) + " /S /D=" + install}
+			if out, err := installCmd.CombinedOutput(); err != nil {
+				t.Fatalf("install: %v\n%s", err, out)
+			}
+			if !registered() {
+				t.Fatal("fixture install did not register")
+			}
+			uninstaller := filepath.Join(base, mode+"-uninstall.exe")
+			bytes, err := os.ReadFile(filepath.Join(install, "Uninstall.exe"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(uninstaller, bytes, 0o700); err != nil {
+				t.Fatal(err)
+			}
+			command := func() *exec.Cmd {
+				cmd := exec.Command(uninstaller)
+				cmd.SysProcAttr = &windows.SysProcAttr{CmdLine: windows.EscapeArg(uninstaller) + " /S _?=" + install}
+				return cmd
+			}
+			var held windows.Handle
+			if mode != "unlocked" {
+				path, err := windows.UTF16PtrFromString(filepath.Join(install, "payload.dat"))
+				if err != nil {
+					t.Fatal(err)
+				}
+				held, err = windows.CreateFile(path, windows.GENERIC_READ, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING, 0, 0)
+				if err != nil {
+					t.Fatal(err)
+				}
+			}
+			cmd := command()
+			if err := cmd.Start(); err != nil {
+				t.Fatal(err)
+			}
+			if mode == "temporary-lock" {
+				// Observe a file actually removed by RMDir before releasing the
+				// lock. A fixed sleep could elapse during the close-app check.
+				deadline := time.Now().Add(20 * time.Second)
+				for fileExists(filepath.Join(install, "Uninstall.exe")) && time.Now().Before(deadline) {
+					time.Sleep(10 * time.Millisecond)
+				}
+				if fileExists(filepath.Join(install, "Uninstall.exe")) {
+					t.Error("uninstaller never reached file removal")
+				}
+				windows.CloseHandle(held)
+				held = 0
+			}
+			err = cmd.Wait()
+			if mode == "persistent-lock" {
+				if err == nil {
+					t.Error("uninstaller reported success with an undeletable file")
+				}
+				if !registered() {
+					t.Error("failed removal discarded recovery registration")
+				}
+				windows.CloseHandle(held)
+				held = 0
+				// Release only this test's lock, then retry the same owned copy.
+				err = command().Run()
+			}
+			if held != 0 {
+				windows.CloseHandle(held)
+			}
+			if err != nil {
+				t.Errorf("removal after lock release: %v", err)
+			}
+			if _, err := os.Stat(install); !os.IsNotExist(err) {
+				t.Errorf("uninstaller left installation: %v", err)
+			}
+			if registered() {
+				t.Error("successful removal left registration")
+			}
+			// Clean only this fixture's registration if testing the unfixed
+			// implementation. Original failures remain in the test result.
+			if registered() {
+				exec.Command("reg.exe", "delete", key, "/f").Run()
+			}
+			shortcut := filepath.Join(shellFolder(t, "Programs"), name+".lnk")
+			if strings.HasPrefix(filepath.Base(shortcut), "Gitowl Removal Test ") {
+				os.Remove(shortcut)
+			}
+		})
+	}
+}
